{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whisker",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-26",
  "secrets": {
    "required": ["API_KEY"],
  },
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whisker",
      "database_id": "d593ca20-0674-4d6e-93be-e10d562de9c9",
      "migrations_dir": "worker/migrations",
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
}
