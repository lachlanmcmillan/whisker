{
  "name": "whisker",
  "private": true,
  "workspaces": {
    "packages": [
      "common",
      "client"
    ],
    "catalog": {
      "typescript": "~6.0.2"
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/bun": "^1.3.11",
    "chalk": "^5.6.2",
    "prettier": "^3.8.1",
    "typescript": "catalog:",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "@whisker/common": "workspace:*",
    "fast-xml-parser": "^5.5.10"
  },
  "scripts": {
    "dev": "bun run worker:d1:local && bun run worker:build && bun run --parallel worker:serve client:dev",
    "client:dev": "bun run --filter @whisker/client dev",
    "prettier": "prettier --write \"**/src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "tsc": "bun run --filter @whisker/client tsc && bun run worker:tsc",
    "worker:build": "bun run --filter @whisker/client build",
    "worker:tsc": "tsc -p worker/tsconfig.json",
    "worker:dev": "bun run worker:build && wrangler dev",
    "worker:serve": "wrangler dev --port 8787",
    "worker:deploy": "bun run worker:build && wrangler deploy --secrets-file .dev.vars",
    "worker:d1:local": "wrangler d1 migrations apply DB --local",
    "worker:d1:remote": "wrangler d1 migrations apply DB --remote"
  }
}
